---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  description?: string;
}

const { id, title, eyebrow, description } = Astro.props;
---

<section id={id} class="border-t border-[color:var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <header class="mb-12 max-w-2xl">
      {eyebrow && (
        <p class="text-sm font-mono text-[color:var(--color-accent)] mb-3">{eyebrow}</p>
      )}
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">{title}</h2>
      {description && (
        <p class="mt-4 text-[color:var(--color-fg-muted)] text-lg leading-relaxed">{description}</p>
      )}
    </header>
    <slot />
  </div>
</section>
